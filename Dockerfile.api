FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        git \
        libpq-dev \
 && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
RUN pip install --upgrade pip \
 && pip install .

COPY fragchain ./fragchain
COPY alembic.ini ./
COPY scripts ./scripts
COPY prompts ./prompts
COPY chains ./chains

# Drop privileges (SAST S-013): run the API as a non-root user. uvicorn
# binds :8000 (>1024, no capability needed) and `alembic upgrade head`
# only needs DB connectivity + read access to /app, which the app user owns.
RUN groupadd -r app && useradd -r -g app -u 10001 app \
 && chown -R app:app /app
USER app

EXPOSE 8000

CMD ["sh", "-c", "alembic upgrade head && uvicorn fragchain.api.main:app --host 0.0.0.0 --port 8000"]
