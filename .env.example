# ============================================================
# FragChain — environment configuration template
#
# Copy to .env and fill in real values before `docker compose up`.
# NEVER commit .env.
#
# Production / staging boot will be REFUSED if any secret below
# is left as a placeholder, is empty, or is shorter than 16
# characters (see fragchain/config.py:_check_production_secrets).
#
# Generate strong secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   openssl rand -base64 48
# ============================================================

# ---- App ----
# development | staging | production
# Production mode enables strict secret validation, disables /docs and
# /openapi.json, and gates detailed /health behind maintainer auth.
APP_ENV=development
APP_HOST=0.0.0.0
# 32+ bytes of cryptographically strong random data, base64/url-safe encoded
APP_SECRET_KEY=REPLACE_ME_with_a_strong_random_32+_byte_value
APP_LOG_LEVEL=INFO

# ---- Default admin user (created at first start if no users exist) ----
# admin/admin is REFUSED at boot. Pick a real password.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@fragchain.local
ADMIN_PASSWORD=REPLACE_ME_with_a_strong_unique_password

# ---- JWT ----
# Independent random secret — do NOT reuse APP_SECRET_KEY here.
JWT_SECRET=REPLACE_ME_with_an_independent_strong_random_value
JWT_ALGORITHM=HS256
# Short JWT lifetime keeps lost-token blast radius small. 12h is the v1 default;
# drop to 1-4h once WS ticket auth is the only path that needs to hold a token.
JWT_EXPIRY_HOURS=12

# ---- PostgreSQL ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=fragchain
POSTGRES_USER=fragchain
POSTGRES_PASSWORD=REPLACE_ME_with_a_strong_postgres_password

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
# Required: redis-server is launched with --requirepass. Empty values
# cause container startup to fail.
REDIS_PASSWORD=REPLACE_ME_with_a_strong_redis_password
REDIS_DB=0

# ---- MinIO ----
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ROOT_USER=fragchain
MINIO_ROOT_PASSWORD=REPLACE_ME_with_a_strong_minio_password
MINIO_BUCKET=fragchain
MINIO_USE_SSL=false

# ---- Qdrant (local in Server 3 stack) ----
QDRANT_HOST=qdrant
QDRANT_PORT=6333
# Required: Qdrant runs with QDRANT__SERVICE__API_KEY set; empty values
# make /collections endpoints unauthenticated. Generate with `openssl rand`.
QDRANT_API_KEY=REPLACE_ME_with_a_strong_qdrant_api_key

# ---- LiteLLM (mandatory, Server 1, external) ----
# Operator configures LiteLLM to route to whatever chat + embedding models
# they choose. FragChain talks to LiteLLM via OpenAI-compatible API.
LITELLM_BASE_URL=http://litellm.internal:4000
LITELLM_API_KEY=REPLACE_ME_with_your_litellm_api_key
LITELLM_CHAT_MODEL=claude-opus
LITELLM_EMBEDDING_MODEL=nomic-embed-text
# TLS verification for the LiteLLM endpoint.
# Production-grade path: mount your private-CA bundle into the API container
# and point LITELLM_CA_BUNDLE at it.
# Dev shortcut: set LITELLM_VERIFY_TLS=false (NEVER in production —
# production startup rejects LITELLM_VERIFY_TLS=false).
LITELLM_VERIFY_TLS=true
LITELLM_CA_BUNDLE=

# ---- CVE pipeline budgets ----
MAX_LIVE_CVE_PER_HOUR=10
MAX_HISTORICAL_CVE_PER_DAY=20
AUTO_PROCESS_KEV=true

# ---- Assessment workspace ----
# Detectability gate threshold: minimum non-empty observable categories
# (of 7) in Loop 2's output for the gate to pass (CLAUDE.md §12.1).
GATE_MIN_CATEGORIES=3
# Phase 2c gating (ADR-0004): detectability classes for which Loop 3 actively
# SKIPS Sigma generation ("no reliable detection exists" becomes a valid
# outcome) and surfaces a non-Sigma deliverable instead. Only
# insufficient_information / control_only are policy-skip classes. Set to ""
# to restore full compatibility mode (no gating) — the operator kill-switch.
ROUTER_GATING_SKIP_CLASSES=insufficient_information,control_only
# Loop 2 per-pass wall-clock bound in seconds; must be >=
# LLM_STRUCTURED_TIMEOUT_SECONDS (startup-validated) — repair attempts may
# be cancelled mid-pass by design.
LOOP2_PASS_TIMEOUT_SECONDS=150
# Stale in-flight reaper: 'running' loop runs / 'generating' artifacts older
# than this (seconds) are failed by beat; must exceed worst-case loop wall-clock.
STALE_INFLIGHT_MAX_SECONDS=1800

# ---- Intelligence Commons (M7) ----
# F-001: MUST stay false in production. Production startup refuses to
# accept COMMONS_ALLOW_MOCK_FALLBACK=true so a misconfigured deployment
# never silently ships stub commons data. Flip to true only for offline
# development against a non-existent commons source.
COMMONS_ALLOW_MOCK_FALLBACK=false
COMMONS_SYNC_TIMEOUT_SECONDS=60
# Override for GitHub Enterprise; leave default for public github.com.
COMMONS_GITHUB_API_BASE=https://api.github.com

# ---- CORS ----
# Comma-separated list of allowed origins for the API. Must include the
# public scheme + host the UI loads from. Wildcards (*) are not accepted.
CORS_ORIGINS=https://localhost,https://localhost:443
